      <table>
        <view>
          <datasources>
            <datasource caption='citycare_er_visits' name='federated.1kvnlt31qdzpb2171114j1so36fo' />
          </datasources>
          <datasource-dependencies datasource='federated.1kvnlt31qdzpb2171114j1so36fo'>
            <column caption='Department Wait Rank' datatype='integer' name='[Calculation_2246614827319298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK(AVG([wait_time_min]), &apos;desc&apos;)'>
                <table-calc ordering-field='[federated.1kvnlt31qdzpb2171114j1so36fo].[department]' ordering-type='Field' />
              </calculation>
            </column>
            <column-instance column='[wait_time_min]' derivation='Avg' name='[avg:wait_time_min:qk]' pivot='key' type='quantitative' />
            <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal' />
            <column-instance column='[department]' derivation='None' name='[none:department:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2246614827319298]' derivation='User' name='[usr:Calculation_2246614827319298:qk:1]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <column caption='Wait Time Min' datatype='integer' name='[wait_time_min]' role='measure' type='quantitative' />
