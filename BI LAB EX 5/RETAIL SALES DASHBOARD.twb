      <aliases enabled='yes' />
      <column caption='Profit Margin %' datatype='real' default-format='p0.00%' name='[Calculation_2156719354937344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Profit])/SUM([Sales]))*100' />
      </column>
      <column caption='Sales Growth %' datatype='real' name='[Calculation_2156719359205377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - LOOKUP(SUM([Sales]),-1))&#13;&#10;/&#13;&#10;ABS(LOOKUP(SUM([Sales]),-1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YTD Sales' datatype='real' name='[Calculation_2156719359328258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Average Profit' datatype='real' name='[Calculation_2156719359459331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Profit])' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_2156719359545348]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Order ID])' />
      </column>
      <column caption='Selected KPI' datatype='real' name='[Calculation_2156719361777670]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2156719360000005] = &quot;Sales&quot; THEN&#13;&#10;    SUM([Sales])&#13;&#10;ELSE&#13;&#10;    SUM([Profit])&#13;&#10;END' />
      </column>
