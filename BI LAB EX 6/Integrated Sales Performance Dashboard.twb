      </column>
      <column caption='Sales Variance' datatype='real' name='[Calculation_2160843915567107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) - SUM([Sales Target])' />
      </column>
      <column caption='Performance Indicator' datatype='string' name='[Calculation_2160843915694084]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Sales]) &gt;= SUM([Sales Target])&#13;&#10;&#13;&#10;THEN &quot;Achieved&quot;&#13;&#10;&#13;&#10;ELSE &quot;Below Target&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Target Achievement %' datatype='real' default-format='p0.00%' name='[Calculation_2160843934085125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / AVG([Sales Target]) * 100' />
      </column>
