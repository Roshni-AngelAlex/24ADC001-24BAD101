      <aliases enabled='yes' />
      <column caption='Total Sales' datatype='real' name='[Calculation_2160843914964992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])' />
      </column>
      <column caption='Total Target' datatype='integer' name='[Calculation_2160843915063297]' role='measure' type='quantitative'>
